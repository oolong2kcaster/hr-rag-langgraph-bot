# Required for embedding + answer generation
OPENAI_API_KEY=your_openai_api_key_here

# You can change models depending on your account / platform availability
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Qdrant service name inside docker-compose is qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=hr_documents

# Ingestion
DATA_DIR=data/raw
PROCESSED_DIR=data/processed
LOG_DIR=logs
OCR_ENABLED=true
OCR_LANG=vie+eng
CHUNK_SIZE=900
CHUNK_OVERLAP=160

# Retrieval
RETRIEVAL_TOP_K=6
SEMANTIC_CANDIDATES=18
MAX_CONTEXT_CHARS=9000
MIN_RELEVANCE_SCORE=0.20

# Slack phase later; not required for CLI phase 1
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
